# Server-only template. Do not commit filled .env files. No deployment in Phase B.
SUPABASE_URL=
ENVIRONMENT=development
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RATE_LIMIT_HMAC_SECRET=
APP_ORIGIN=http://127.0.0.1:8787
ORDERING_ENABLED=false
PAYMENTS_MODE=disabled
EMAIL_PROVIDER=mock
ARTWORK_UPLOADS_ENABLED=false
OTP_HMAC_SECRET=
# Phase D's local runner generates an ephemeral OTP secret; the edge adapter does not activate tracking.
# Production DNS, email, OTP and payment credentials are intentionally not needed.

# Phase G candidates: server only. Leave every activation gate false.
STAGING_ADMIN_APPROVED=false
TRANSACTIONAL_EMAIL_ENABLED=false
EMAIL_DOMAIN_VERIFIED=false
EMAIL_OWNER_APPROVED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_ALLOWED_RECIPIENTS=
EMAIL_FROM=noreply@netbud.com.au
EMAIL_REPLY_TO=sales@netbud.com.au
OTP_TRANSPORT_KEY_HEX=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=
# New API botGuard must be wired explicitly after hosted testing; existing FormSubmit is untouched.
# Use a separate off-site backup key; never put it beside a backup or in the browser.
BACKUP_KEY_HEX=
