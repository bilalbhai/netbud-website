# Server-only template. Do not commit filled .env files. No deployment in Phase B.
SUPABASE_URL=
ENVIRONMENT=development
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RATE_LIMIT_HMAC_SECRET=
APP_ORIGIN=http://127.0.0.1:8787
ORDERING_ENABLED=false
PAYMENTS_MODE=disabled
EMAIL_PROVIDER=mock
ARTWORK_UPLOADS_ENABLED=false
OTP_HMAC_SECRET=
# Phase D's local runner generates an ephemeral OTP secret; the edge adapter does not activate tracking.
# Production DNS, email, OTP and payment credentials are intentionally not needed.
